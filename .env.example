# Environment Configuration Template for Smart School Management System

# Database URL:
# For SQLite (Instant local run - default):
DATABASE_URL="file:./dev.db"

# For PostgreSQL / Supabase:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public"

# Authentication:
JWT_SECRET="your-super-strong-jwt-secret-key-change-in-production"

# App Info:
NEXT_PUBLIC_APP_NAME="Smart School Management System"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
